# Supabase 프로젝트 → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 운영 화면(/admin) 비밀번호. 팀원끼리만 공유
ADMIN_PASSWORD=
# 앱 알림(웹 푸시) 키: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase pg_cron이 /api/cron/remind 를 부를 때 쓰는 비밀 값 (Vault의 boim_cron_secret과 같게)
CRON_SECRET=
# 알림을 누르면 열릴 주소
APP_URL=https://boim-ten.vercel.app
# 켠 소셜 로그인만 적는다 (Supabase에서 제공자를 먼저 켤 것). 예: kakao,google
NEXT_PUBLIC_AUTH_PROVIDERS=
